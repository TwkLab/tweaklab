<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Verificadas da Identidade Visual TweakLab -->
    <Color x:Key="TwkBgColor">#050605</Color>
    <Color x:Key="TwkSurfaceColor">#0A0D0A</Color>
    <Color x:Key="TwkCardColor">#0F140F</Color>
    <Color x:Key="TwkBorderColor">#1C261C</Color>
    <Color x:Key="TwkGreenColor">#00FF88</Color>
    <Color x:Key="TwkGreenHoverColor">#00D976</Color>
    <Color x:Key="TwkTextColor">#F5F7F5</Color>
    <Color x:Key="TwkMutedColor">#9CA3AF</Color>
    <Color x:Key="TwkDimColor">#6B7280</Color>
    <Color x:Key="TwkInfoColor">#00E5FF</Color>
    <Color x:Key="TwkAlertColor">#F59E0B</Color>
    <Color x:Key="TwkErrorColor">#EF4444</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="TwkBgBrush" Color="{StaticResource TwkBgColor}" />
    <SolidColorBrush x:Key="TwkSurfaceBrush" Color="{StaticResource TwkSurfaceColor}" />
    <SolidColorBrush x:Key="TwkCardBrush" Color="{StaticResource TwkCardColor}" />
    <SolidColorBrush x:Key="TwkBorderBrush" Color="{StaticResource TwkBorderColor}" />
    <SolidColorBrush x:Key="TwkGreenBrush" Color="{StaticResource TwkGreenColor}" />
    <SolidColorBrush x:Key="TwkGreenHoverBrush" Color="{StaticResource TwkGreenHoverColor}" />
    <SolidColorBrush x:Key="TwkTextBrush" Color="{StaticResource TwkTextColor}" />
    <SolidColorBrush x:Key="TwkMutedBrush" Color="{StaticResource TwkMutedColor}" />
    <SolidColorBrush x:Key="TwkDimBrush" Color="{StaticResource TwkDimColor}" />
    <SolidColorBrush x:Key="TwkInfoBrush" Color="{StaticResource TwkInfoColor}" />
    <SolidColorBrush x:Key="TwkAlertBrush" Color="{StaticResource TwkAlertColor}" />
    <SolidColorBrush x:Key="TwkErrorBrush" Color="{StaticResource TwkErrorColor}" />

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Estilo de Botão Primário Neon -->
    <Style x:Key="TwkPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TwkGreenBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TwkBgBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource TwkGreenHoverBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource TwkGreenHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo de Botão Secundário / Superfície -->
    <Style x:Key="TwkSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TwkSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TwkTextBrush}" />
        <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource TwkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource TwkGreenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TwkGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
