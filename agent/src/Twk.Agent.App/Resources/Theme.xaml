<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         TweakLab Design System — Pinnacle Cyber HUD Pro
         High-tech Dark Theme: Deep Void (#07080A) + Electric Green (#00E676)
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Core Colors -->
    <Color x:Key="TwkBgColor">#07080A</Color>
    <Color x:Key="TwkSidebarColor">#0B0D12</Color>
    <Color x:Key="TwkSurfaceColor">#0F1218</Color>
    <Color x:Key="TwkCardColor">#131720</Color>
    <Color x:Key="TwkCardHoverColor">#191E2B</Color>
    <Color x:Key="TwkBorderColor">#202635</Color>
    <Color x:Key="TwkBorderSubtleColor">#151923</Color>

    <!-- Neon Accents -->
    <Color x:Key="TwkGreenColor">#00E676</Color>
    <Color x:Key="TwkGreenDimColor">#00C864</Color>
    <Color x:Key="TwkGreenGlowColor">#2E00E676</Color>
    <Color x:Key="TwkCyanColor">#00D2FF</Color>
    <Color x:Key="TwkPurpleColor">#A855F7</Color>
    <Color x:Key="TwkAmberColor">#F59E0B</Color>
    <Color x:Key="TwkRedColor">#EF4444</Color>

    <!-- Text Hierarchy -->
    <Color x:Key="TwkTextColor">#F8FAFC</Color>
    <Color x:Key="TwkTextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TwkTextDimColor">#64748B</Color>
    <Color x:Key="TwkTextDisabledColor">#334155</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="TwkBgBrush" Color="{StaticResource TwkBgColor}" />
    <SolidColorBrush x:Key="TwkSidebarBrush" Color="{StaticResource TwkSidebarColor}" />
    <SolidColorBrush x:Key="TwkSurfaceBrush" Color="{StaticResource TwkSurfaceColor}" />
    <SolidColorBrush x:Key="TwkCardBrush" Color="{StaticResource TwkCardColor}" />
    <SolidColorBrush x:Key="TwkCardHoverBrush" Color="{StaticResource TwkCardHoverColor}" />
    <SolidColorBrush x:Key="TwkBorderBrush" Color="{StaticResource TwkBorderColor}" />
    <SolidColorBrush x:Key="TwkBorderSubtleBrush" Color="{StaticResource TwkBorderSubtleColor}" />

    <SolidColorBrush x:Key="TwkGreenBrush" Color="{StaticResource TwkGreenColor}" />
    <SolidColorBrush x:Key="TwkGreenDimBrush" Color="{StaticResource TwkGreenDimColor}" />
    <SolidColorBrush x:Key="TwkGreenGlowBrush" Color="{StaticResource TwkGreenGlowColor}" />
    <SolidColorBrush x:Key="TwkCyanBrush" Color="{StaticResource TwkCyanColor}" />
    <SolidColorBrush x:Key="TwkPurpleBrush" Color="{StaticResource TwkPurpleColor}" />
    <SolidColorBrush x:Key="TwkAmberBrush" Color="{StaticResource TwkAmberColor}" />
    <SolidColorBrush x:Key="TwkRedBrush" Color="{StaticResource TwkRedColor}" />

    <SolidColorBrush x:Key="TwkTextBrush" Color="{StaticResource TwkTextColor}" />
    <SolidColorBrush x:Key="TwkTextSecondaryBrush" Color="{StaticResource TwkTextSecondaryColor}" />
    <SolidColorBrush x:Key="TwkDimBrush" Color="{StaticResource TwkTextDimColor}" />
    <SolidColorBrush x:Key="TwkTextDimBrush" Color="{StaticResource TwkTextDimColor}" />
    <SolidColorBrush x:Key="TwkMutedBrush" Color="{StaticResource TwkTextSecondaryColor}" />

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Typography -->
    <FontFamily x:Key="UIFont">Segoe UI Variable Display, Segoe UI, Inter, -apple-system, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- ═══ Title Bar Caption Buttons ═══ -->
    <Style x:Key="WindowCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TwkTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TwkCardHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TwkTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TwkTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DC2626" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Primary Neon Button ═══ -->
    <Style x:Key="TwkPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TwkGreenBrush}" />
        <Setter Property="Foreground" Value="#07080A" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TwkGreenDimBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Secondary Outlined Button ═══ -->
    <Style x:Key="TwkSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TwkCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TwkTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TwkCardHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TwkGreenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TwkGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Compact Action Button ═══ -->
    <Style x:Key="TwkCompactButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TwkSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TwkTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource TwkBorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TwkCardHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TwkGreenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TwkGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Category Filter Chip ═══ -->
    <Style x:Key="CategoryChipButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TwkCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TwkTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource TwkBorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TwkCardHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TwkGreenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TwkGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Sidebar Nav Button ═══ -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TwkTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Grid.Column="0" Width="3" CornerRadius="1.5"
                                    Background="Transparent" Margin="0,1,10,1" VerticalAlignment="Stretch" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TwkCardBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TwkTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#112419" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource TwkGreenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TwkGreenBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Dark Input Box ═══ -->
    <Style x:Key="TwkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource TwkSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TwkTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TwkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CaretBrush" Value="{StaticResource TwkGreenBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource TwkGreenGlowBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TwkGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Dark CheckBox ═══ -->
    <Style x:Key="TwkCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TwkTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                Background="{StaticResource TwkSurfaceBrush}"
                                BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Text="✓" FontSize="11" FontWeight="Bold"
                                       Foreground="#07080A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource TwkGreenBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TwkGreenBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TwkGreenDimBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ ProgressBar ═══ -->
    <Style x:Key="TwkProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="#151924" />
        <Setter Property="Foreground" Value="{StaticResource TwkGreenBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Modern Thin Dark ScrollBar ═══ -->
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border CornerRadius="3" Background="#252C3D" Margin="1,0,1,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="7" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
