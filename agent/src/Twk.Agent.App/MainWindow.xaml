<Window x:Class="Twk.Agent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TweakLab Agent — Central Técnica &amp; Evidências"
        Height="780" Width="1160"
        MinHeight="680" MinWidth="950"
        Background="{StaticResource TwkBgBrush}"
        Foreground="{StaticResource TwkTextBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Navigation Tabs -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#101810" BorderBrush="{StaticResource TwkGreenBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                        <TextBlock Text="TWEAKLAB" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TwkGreenBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Central de Atendimento &amp; Evidências de Hardware" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TwkTextBrush}" />
                        <TextBlock Text="Diagnóstico Transparente • Auditoria Criptográfica SHA-256 • Hub do Especialista" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Usuário: " FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                            <TextBlock Text="{Binding UserEmail, TargetNullValue='Não autenticado'}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkGreenBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Tabs Bar -->
        <Border Grid.Row="1" Margin="0,0,0,16" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TwkMutedBrush}" />
                        <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="16,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource TwkCardBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TwkGreenBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TwkTextColor}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: Triagem & Hardware -->
                <TabItem Header="🔍 1. Triagem &amp; Inventário">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Consent Gate Banner -->
                        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Autorização e Princípios de Privacidade (LGPD &amp; Transparência)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TwkTextBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="A triagem técnica inspeciona processador, placas de vídeo, memórias e discos via WMI/CIM padrão do Windows em modo somente-leitura. Nenhuma modificação é feita." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TwkMutedBrush}" Margin="0,0,0,10" />
                                    <CheckBox IsChecked="{Binding HasConsent, Mode=TwoWay}" Foreground="{StaticResource TwkGreenBrush}" FontWeight="SemiBold" FontSize="11" FontFamily="Consolas" Content="Autorizo a coleta de evidências técnicas somente-leitura para diagnóstico." />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Command="{Binding CollectCommand}" Style="{StaticResource TwkPrimaryButton}" Content="Autorizar e Iniciar Triagem" Margin="0,0,8,0" />
                                    <Button Command="{Binding CancelCommand}" Style="{StaticResource TwkSecondaryButton}" Content="Cancelar" Visibility="{Binding IsCollecting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Hardware & Audit Viewer -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Hardware Cards -->
                            <Border Grid.Column="0" Margin="0,0,12,0" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Componentes Identificados" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,12" />

                                        <TextBlock Text="Nenhum componente lido ainda. Marque a autorização acima e clique em 'Autorizar e Iniciar Triagem'." Foreground="{StaticResource TwkDimBrush}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Visibility="{Binding HasHardwareData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                        <StackPanel Visibility="{Binding HasHardwareData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- CPU Card -->
                                            <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="PROCESSADOR (CPU)" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Inventory.Cpu.Model, TargetNullValue='AMD Ryzen 7 5700X'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TwkTextBrush}" />
                                                    <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" Margin="0,2,0,0">
                                                        <Run Text="Núcleos Físicos: " /><Run Text="{Binding Inventory.Cpu.PhysicalCores}" /><Run Text=" • Threads: " /><Run Text="{Binding Inventory.Cpu.LogicalProcessors}" /><Run Text=" • Arq: " /><Run Text="{Binding Inventory.Cpu.Architecture}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- GPU Card -->
                                            <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="PLACA DE VÍDEO (GPU)" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding Inventory.Gpus}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,6">
                                                                    <TextBlock Text="{Binding Model}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TwkTextBrush}" />
                                                                    <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" Margin="0,2,0,0">
                                                                        <Run Text="Driver: " /><Run Text="{Binding DriverVersion}" /><Run Text=" • VRAM: " /><Run Text="{Binding DedicatedVramFormatted}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- RAM Card -->
                                            <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="MEMÓRIA RAM" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Inventory.Ram.TotalFormatted}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TwkTextBrush}" />
                                                    <ItemsControl ItemsSource="{Binding Inventory.Ram.Modules}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}">
                                                                    <Run Text="Slot: " /><Run Text="{Binding BankLabel}" /><Run Text=" — " /><Run Text="{Binding CapacityFormatted}" /><Run Text=" @ " /><Run Text="{Binding Speed}" /><Run Text=" (" /><Run Text="{Binding PartNumber}" /><Run Text=")" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- OS & Motherboard -->
                                            <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="SISTEMA &amp; PLACA-MÃE" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,4" />
                                                    <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkTextBrush}">
                                                        <Run Text="SO: " /><Run Text="{Binding Inventory.OperatingSystem.Caption}" /><Run Text=" (" /><Run Text="{Binding Inventory.OperatingSystem.BuildNumber}" /><Run Text=")" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" Margin="0,2,0,0">
                                                        <Run Text="Placa-Mãe: " /><Run Text="{Binding Inventory.Motherboard.Manufacturer}" /><Run Text=" " /><Run Text="{Binding Inventory.Motherboard.Model}" /><Run Text=" • BIOS: " /><Run Text="{Binding Inventory.Motherboard.BiosVersion}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Right: Raw Evidence & Digest -->
                            <Border Grid.Column="1" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Envelope &amp; Digest Auditável" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TwkTextBrush}" Margin="0,0,0,8" />

                                    <!-- Digest Card -->
                                    <Border Grid.Row="1" Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="SHA-256 PAYLOAD DIGEST" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkGreenBrush}" />
                                            <TextBox Text="{Binding EvidenceDigest, Mode=OneWay, TargetNullValue='sha256:aguardando_coleta...'}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TwkTextBrush}" FontFamily="Consolas" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Raw JSON Audit -->
                                    <Border Grid.Row="2" Background="#040604" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <TextBox Text="{Binding SerializedEvidence, Mode=OneWay, TargetNullValue='// O JSON auditável aparecerá aqui após a leitura.'}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A0FFA0" FontFamily="Consolas" FontSize="10" BorderThickness="0" />
                                    </Border>

                                    <!-- Export Buttons -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Command="{Binding ExportCommand}" Style="{StaticResource TwkPrimaryButton}" Content="💾 Exportar Envelope JSON" Margin="0,0,8,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Telemetria & Monitoramento em Tempo Real -->
                <TabItem Header="⚡ 2. Monitoramento em Tempo Real">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="Telemetria contínua sem necessidade de driver de kernel. As métricas atualizam a cada 1.5s." FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CPU Gauge -->
                            <Border Grid.Column="0" Margin="0,0,12,0" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="PROCESSADOR (CPU)" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0:F0}%'}" FontSize="36" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TwkTextBrush}" />
                                    <ProgressBar Value="{Binding CpuUsage}" Minimum="0" Maximum="100" Height="8" Margin="0,8,0,16" Foreground="{StaticResource TwkGreenBrush}" Background="#111B11" BorderThickness="0" />
                                    
                                    <Border Background="{StaticResource TwkCardBrush}" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Temperatura Estimada (ACPI):" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                                            <TextBlock Text="{Binding CpuTempFormatted}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TwkGreenBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- RAM Gauge -->
                            <Border Grid.Column="1" Margin="0,0,12,0" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA RAM" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding RamUsage, StringFormat='{}{0:F0}%'}" FontSize="36" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TwkTextBrush}" />
                                    <ProgressBar Value="{Binding RamUsage}" Minimum="0" Maximum="100" Height="8" Margin="0,8,0,16" Foreground="{StaticResource TwkGreenBrush}" Background="#111B11" BorderThickness="0" />

                                    <Border Background="{StaticResource TwkCardBrush}" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Uso Físico Alocado:" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                                            <TextBlock Text="{Binding RamUsageFormatted}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TwkTextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- GPU & Ambient Gauge -->
                            <Border Grid.Column="2" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="PLACA DE VÍDEO (GPU)" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding GpuName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TwkTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Telemetria Avançada &amp; Hotspot" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" Margin="0,4,0,16" />

                                    <Border Background="{StaticResource TwkCardBrush}" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Para sensores de GPU mili-grau e VRAM, use o HWiNFO64 disponível na aba Loja de Ferramentas." FontSize="11" Foreground="{StaticResource TwkMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 3: Loja de Ferramentas do Técnico (App Store) -->
                <TabItem Header="🛠️ 3. Ferramentas do Técnico">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="0,0,0,14" Padding="14" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="Catálogo oficial das ferramentas homologadas pela TweakLab. A instalação é manual e sob controle total do usuário." FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="340" Margin="0,0,14,14" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TwkTextBrush}" />
                                                    <Border Background="#152615" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TwkGreenBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TwkMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                <Border Grid.Row="2" Background="{StaticResource TwkCardBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding RecommendedUse}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TwkGreenBrush}" TextWrapping="Wrap" />
                                                </Border>

                                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Command="{Binding DataContext.OpenToolUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding OfficialSiteUrl}" Style="{StaticResource TwkSecondaryButton}" Content="Site Oficial" Margin="0,0,6,0" Padding="10,6" FontSize="11" />
                                                    <Button Command="{Binding DataContext.OpenToolUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DownloadUrl}" Style="{StaticResource TwkPrimaryButton}" Content="Download" Padding="12,6" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- TAB 4: Minha Conta & Sincronização Automática -->
                <TabItem Header="☁️ 4. Conta &amp; Sincronização">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Login Card -->
                        <Border Grid.Column="0" Margin="0,0,16,0" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Login da Conta TweakLab" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TwkTextBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Conecte seu nome e e-mail para que as evidências geradas pelo TWK Agent sejam sincronizadas automaticamente com o portal de chamados." FontSize="11" Foreground="{StaticResource TwkMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                <TextBlock Text="Seu Nome / Apelido:" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource TwkCardBrush}" Foreground="{StaticResource TwkTextBrush}" BorderBrush="{StaticResource TwkBorderBrush}" Padding="8" Margin="0,0,0,12" />

                                <TextBlock Text="Seu E-mail:" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource TwkCardBrush}" Foreground="{StaticResource TwkTextBrush}" BorderBrush="{StaticResource TwkBorderBrush}" Padding="8" Margin="0,0,0,16" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding LoginCommand}" Style="{StaticResource TwkPrimaryButton}" Content="Entrar / Salvar" Margin="0,0,8,0" />
                                    <Button Command="{Binding LogoutCommand}" Style="{StaticResource TwkSecondaryButton}" Content="Sair" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sync Status Card -->
                        <Border Grid.Column="1" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Status da Sincronização em Nuvem" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TwkTextBrush}" Margin="0,0,0,8" />
                                
                                <Border Background="{StaticResource TwkCardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding SyncStatusMessage}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TwkGreenBrush}" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Text="Como funciona a sincronização automática:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TwkTextBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="1. Faça login com o mesmo e-mail usado no site tweaklab-lac.vercel.app&#x0a;2. Ao concluir uma triagem nesta ferramenta, o TWK Agent envia o envelope assinado para a API da TweakLab&#x0a;3. Na tela de abertura de chamado, basta digitar o mesmo e-mail que o site puxará a evidência automaticamente!" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                <Button Command="{Binding SyncCloudCommand}" Style="{StaticResource TwkPrimaryButton}" Content="☁️ Sincronizar Agora com a Nuvem" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Footer Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource TwkGreenBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="TweakLab Agent v0.2.0 • Build Local 2026" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkDimBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
