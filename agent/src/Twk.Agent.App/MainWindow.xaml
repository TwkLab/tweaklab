<Window x:Class="Twk.Agent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TweakLab Agent (TWK) — Coleta de Evidências &amp; Diagnóstico"
        Height="720" Width="1040"
        MinHeight="600" MinWidth="850"
        Background="{StaticResource TwkBgBrush}"
        Foreground="{StaticResource TwkTextBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Consent Card -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20" Padding="0,0,0,16" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#101810" BorderBrush="{StaticResource TwkGreenBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                        <TextBlock Text="TWK AGENT" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TwkGreenBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TweakLab Diagnostic &amp; Evidence Engine" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TwkTextBrush}" />
                        <TextBlock Text="Fase 1 • Modo Local Offline • Somente Leitura (Standard User)" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="Sessão: Usuário Padrão" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkGreenBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Consent Card (Aviso Prévio Obrigatório) -->
        <Border Grid.Row="1" Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#252010" BorderBrush="{StaticResource TwkAlertBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="CONSENTIMENTO EXPLÍCITO" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkAlertBrush}" />
                        </Border>
                        <TextBlock Text="Autorização para Leitura Local de Hardware" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TwkTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="O TWK Agent consultará informações de hardware (CPU, RAM, GPU, Discos, Placa-mãe e Versão do Windows) apenas para leitura local. Nenhum arquivo pessoal, histórico ou senha é acessado. Nenhuma modificação é feita no sistema."
                               FontSize="11" Foreground="{StaticResource TwkMutedBrush}" TextWrapping="Wrap" LineHeight="16" MaxWidth="760" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Checkbox & Action Button -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <CheckBox IsChecked="{Binding HasConsent, Mode=TwoWay}" Foreground="{StaticResource TwkTextBrush}" FontSize="11" FontFamily="Consolas" Margin="0,0,0,8" Cursor="Hand">
                        <TextBlock Text="Autorizo a leitura do hardware" VerticalAlignment="Center" />
                    </CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Coletar Inventário" Style="{StaticResource TwkPrimaryButton}" Command="{Binding CollectCommand}" Margin="0,0,8,0" />
                        <Button Content="Cancelar" Style="{StaticResource TwkSecondaryButton}" Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Hardware Display & Audit Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Hardware Specs View -->
                <ColumnDefinition Width="3*" />
                <!-- Audit & Raw Json View -->
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Hardware Cards (When Collected) -->
            <Border Grid.Column="0" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ESPECIFICAÇÕES TÉCNICAS DO COMPUTADOR" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkGreenBrush}" Margin="0,0,0,14" />

                        <!-- Placeholder when no data -->
                        <Border Visibility="{Binding HasInventory, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Margin="0,0,0,0" />

                        <!-- Hardware Info Rows -->
                        <StackPanel>
                            <!-- CPU -->
                            <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="PROCESSADOR (CPU)" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                                    <TextBlock Text="{Binding Inventory.Cpu.Model, FallbackValue='Aguardando autorização de coleta...'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TwkTextBrush}" Margin="0,3,0,4" />
                                    <TextBlock Text="{Binding Inventory.Cpu.PhysicalCores, StringFormat='Núcleos Físicos: {0} | Threads: '}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkDimBrush}">
                                        <!-- Inline Threads -->
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- GPU -->
                            <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="PLACA DE VÍDEO (GPU)" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding Inventory.Gpus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4,0,4">
                                                    <TextBlock Text="{Binding Model}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TwkGreenBrush}" />
                                                    <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkDimBrush}">
                                                        <Run Text="Driver: " /><Run Text="{Binding DriverVersion}" Foreground="{StaticResource TwkMutedBrush}" />
                                                        <Run Text=" • VRAM: " /><Run Text="{Binding DedicatedVramFormatted}" Foreground="{StaticResource TwkMutedBrush}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA RAM" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                                    <TextBlock Text="{Binding Inventory.Ram.TotalFormatted, FallbackValue='Aguardando coleta...'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TwkTextBrush}" Margin="0,3,0,4" />
                                    <ItemsControl ItemsSource="{Binding Inventory.Ram.Modules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TwkDimBrush}" Margin="0,1">
                                                    <Run Text="[Módulo] " /><Run Text="{Binding BankLabel}" /><Run Text=": " /><Run Text="{Binding CapacityFormatted}" /><Run Text=" @ " /><Run Text="{Binding Speed}" /><Run Text=" (" /><Run Text="{Binding Manufacturer}" /><Run Text=")" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Motherboard & OS -->
                            <Border Background="{StaticResource TwkCardBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SISTEMA &amp; PLACA-MÃE" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" />
                                    <TextBlock Text="{Binding Inventory.OperatingSystem.Caption, FallbackValue='Windows'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TwkTextBrush}" Margin="0,3,0,2" />
                                    <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkDimBrush}">
                                        <Run Text="Build: " /><Run Text="{Binding Inventory.OperatingSystem.BuildNumber}" />
                                        <Run Text=" • Placa-Mãe: " /><Run Text="{Binding Inventory.Motherboard.Model}" />
                                        <Run Text=" (BIOS: " /><Run Text="{Binding Inventory.Motherboard.BiosVersion}" /><Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Audit & Envelope View -->
            <Border Grid.Column="1" Background="{StaticResource TwkSurfaceBrush}" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="AUDITORIA &amp; ENVELOPE DE EVIDÊNCIA" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TwkInfoBrush}" />
                        <TextBlock Text="Hash SHA-256 da Evidência Sanitizada:" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" Margin="0,4,0,2" />
                        <TextBox Text="{Binding EvidenceDigest, Mode=OneWay, FallbackValue='(Aguardando geração da evidência)'}" 
                                 IsReadOnly="True" Background="{StaticResource TwkCardBrush}" Foreground="{StaticResource TwkGreenBrush}" 
                                 BorderBrush="{StaticResource TwkBorderBrush}" FontFamily="Consolas" FontSize="10" Padding="6,4" />
                    </StackPanel>

                    <TextBox Grid.Row="1" Text="{Binding SerializedEvidence, Mode=OneWay, FallbackValue='O payload JSON sanitizado aparecerá aqui após a leitura autorizada.'}" 
                             IsReadOnly="True" Background="{StaticResource TwkCardBrush}" Foreground="{StaticResource TwkMutedBrush}" 
                             BorderBrush="{StaticResource TwkBorderBrush}" FontFamily="Consolas" FontSize="10" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8" TextWrapping="NoWrap" />

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="Exportar Evidência JSON" Style="{StaticResource TwkPrimaryButton}" Command="{Binding ExportCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,8,0,0" BorderBrush="{StaticResource TwkBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TwkMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="TweakLab Agent v0.1.0-beta" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TwkDimBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
